{
  "name": "tandem",
  "productName": "Tandem",
  "version": "1.0.0",
  "description": "A modern dual-pane file manager for the keyboard",
  "author": "Tandem",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "playwright test",
    "check": "npm run lint && npm test",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "electron": "33.2.1",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "globals": "17.13.0"
  },
  "build": {
    "appId": "app.tandem.filemanager",
    "productName": "Tandem",
    "copyright": "Copyright © 2026 the Tandem authors",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tandem",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "uninstallDisplayName": "Tandem",
      "artifactName": "Tandem-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Tandem-Portable-${version}.exe"
    }
  }
}
